# 数据库类型: mysql
DB_TYPE=mysql
# 数据库主机
DB_HOST=localhost
# 数据库端口
DB_PORT=3306
# 数据库名
DB_NAME=task_db
# 用户名
DB_USER=root
# 密码 (必填)
DB_PASSWORD=your_password_here
# 任务表名
TASK_TABLE=task
# 状态字段
STATUS_COLUMN=status
# 失败原因字段
FAIL_REASON_COLUMN=fail_reason
# 创建时间字段
CREATED_AT_COLUMN=created_at
# 报告输出目录
OUTPUT_DIR=reports
# 历史数据保留天数
RETENTION_DAYS=90